<Window x:Class="RFIDReader.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFID RC522 Reader"
        Height="610"
        Width="760"
        MinHeight="560"
        MinWidth="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Connection" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Serial port" />
                <ComboBox x:Name="PortComboBox" Grid.Column="2" Height="30" VerticalContentAlignment="Center" />
                <Button Grid.Column="4" Width="34" Height="30" Click="RefreshPortsButton_Click" ToolTip="Refresh port list" Content="Refresh" />
                <Button x:Name="ConnectButton" Grid.Column="6" Height="30" Click="ConnectButton_Click" Content="Connect" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Card" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="UID" />
                <TextBox x:Name="UidTextBox" Grid.Column="2" Height="30" IsReadOnly="True" VerticalContentAlignment="Center" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="MIFARE Classic block" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" Text="Block" />
                <TextBox x:Name="BlockTextBox" Grid.Column="2" Height="30" Text="4" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Key A" />
                <TextBox x:Name="KeyTextBox" Grid.Column="6" Height="30" Text="FFFFFFFFFFFF" VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Data (HEX)" />
                <TextBox x:Name="DataTextBox" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="6" Height="30" VerticalContentAlignment="Center" />

                <TextBlock Grid.Row="4" Grid.ColumnSpan="8" Margin="0,0,0,6" Text="Response" />
                <TextBox x:Name="ResponseTextBox" Grid.Row="4" Grid.ColumnSpan="8" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                <Button x:Name="ReadButton" Grid.Row="6" Grid.Column="4" Height="32" Click="ReadButton_Click" Content="Read block" IsEnabled="False" />
                <Button x:Name="WriteButton" Grid.Row="6" Grid.Column="6" Height="32" Click="WriteButton_Click" Content="Write block" IsEnabled="False" />
            </Grid>
        </GroupBox>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="6" Foreground="DimGray" Text="Choose a serial port and connect." />
    </Grid>
</Window>
